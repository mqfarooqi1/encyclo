# Copy to .env - NEVER commit .env. All values optional; the app runs fully offline without them.
ENCARTA_DATA_DIR=
ENCARTA_HOST=127.0.0.1
ENCARTA_PORT=8000
ENCARTA_LOG_LEVEL=INFO

# AI is strictly optional. With no provider set, the app runs in "no-ai" mode
# and every AI-dependent surface is labelled as unavailable rather than faked.
ENCARTA_AI_PROVIDER=none          # none | anthropic | openai | local
ENCARTA_AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ENCARTA_LOCAL_AI_BASE_URL=http://127.0.0.1:11434

# Network access for the source-verification and update pipeline (off by default)
ENCARTA_ALLOW_NETWORK=0
